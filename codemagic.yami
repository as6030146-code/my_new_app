workflows:
  build-android:
    name: Build Android APK
    max_build_duration: 60
    instance_type: linux_x2
    environment:
      flutter: stable
      android:
        sdk: 34
    scripts:
      - flutter clean
      - flutter pub get
      - flutter build apk --release
    artifacts:
      - build/app/outputs/flutter-apk/app-release.apk